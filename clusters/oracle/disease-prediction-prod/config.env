SPRING_DATASOURCE_URL=jdbc:postgresql://proxmox-postgres.disease-prediction-prod.svc.cluster.local:5432/disease_prediction_prod?sslmode=verify-full&sslrootcert=/etc/postgres-ca/ca.crt
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=2
PREDICTION_SERVICE_BASE_URL=http://proxmox-ai:8000
# Backend authentication with Hanko (MDD Iteration 6). The issuer must equal the token's iss
# claim (public URL); keys and session checks use the in-cluster Service, which the Hanko
# NetworkPolicy allows for this backend. See docs/operations/hanko.md.
HANKO_ISSUER=https://identity.pocket-doc.app
HANKO_AUDIENCE=pocket-doc-prod
HANKO_JWKS_URI=http://hanko-prod.auth-system.svc.cluster.local:8000/.well-known/jwks.json
HANKO_API_URL=http://hanko-prod.auth-system.svc.cluster.local:8000
