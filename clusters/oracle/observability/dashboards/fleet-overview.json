  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Purpose and coverage",
      "description": "Cluster state and node capacity for Oracle and Proxmox. Missing data means telemetry is unavailable, not zero.",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Use this page to spot cluster-wide problems, then open **Kubernetes / Cluster Detail** and select a cluster, namespace, and node. Green and red thresholds are visual cues; they are not alert rules. Oracle has node-level usage and workload state, while per-container CPU and memory metrics are available for Proxmox only."
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Count of nodes reporting Ready. No data means the kube-state-metrics scrape is missing.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "noValue": "Unknown",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 3
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (cluster) (kube_node_status_condition{condition=\"Ready\", status=\"true\"})",
          "legendFormat": "{{cluster}}",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Ready nodes",
      "type": "stat"
    },
