          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "100 * (1 - avg by (cluster, nodename) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m]) * on (cluster, instance) group_left(nodename) node_uname_info))",
          "legendFormat": "{{cluster}} / {{nodename}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "title": "Node CPU used",
      "type": "timeseries"
