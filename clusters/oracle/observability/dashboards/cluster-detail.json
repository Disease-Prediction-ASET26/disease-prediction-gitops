  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "How to use this dashboard",
      "description": "Select a cluster, then narrow to a namespace or node. Empty panels mean the selected resource is not present or its metrics are unavailable.",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Choose **Cluster**, **Namespace**, and **Node** above to narrow the view. Node CPU and memory use comes from node-exporter. Workload CPU and memory show requests against allocatable capacity; Oracle per-container usage is not collected. This repository does not ship logs or traces."
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Each node reports 1 while Ready and 0 while not Ready.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "noValue": "Unknown",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "short",
          "max": 1,
          "min": 0,
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "drawStyle": "line",
            "fillOpacity": 12,
            "gradientMode": "none",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 4,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 3
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "kube_node_status_condition{cluster=~\"$cluster\", node=~\"$node\", condition=\"Ready\", status=\"true\"}",
          "legendFormat": "{{cluster}} / {{node}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "title": "Node readiness",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "CPU busy percentage normalized across each node's CPU cores.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "noValue": "Unknown",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          },
          "unit": "percent",
          "max": 100,
          "min": 0,
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "drawStyle": "line",
            "fillOpacity": 12,
            "gradientMode": "none",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 4,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 3
      },
      "id": 3,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "100 * (1 - avg by (cluster, nodename) (rate(node_cpu_seconds_total{cluster=~\"$cluster\", mode=\"idle\"}[5m]) * on (cluster, instance) group_left(nodename) node_uname_info{cluster=~\"$cluster\", nodename=~\"$node\"}))",
          "legendFormat": "{{cluster}} / {{nodename}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "title": "Node CPU used",
      "type": "timeseries"
    },
    {
      "datasource": {
